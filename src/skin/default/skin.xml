<Skin>
  <!-- Set player's background Image -->
  <bgImage path="background.gif" />
 
  <!-- Add buttons to player-->
  <button imgUp="prev_up.gif" imgDown="prev_down.gif" event="prev" x="4" y="20" toolTip="Previous" />
  <button imgUp="play_up.gif" imgDown="play_down.gif" event="play" x="4" y="40" toolTip="Play" />
  <button imgUp="pause_up.gif" imgDown="pause_down.gif" event="pause" x="4" y="60" toolTip="Pause" />
  <button imgUp="stop_up.gif" imgDown="stop_down.gif" event="stop" x="4" y="80" toolTip="Stop" /> 
  <button imgUp="next_up.gif" imgDown="next_down.gif" event="next" x="4" y="100" toolTip="Next" />
  <button imgUp="systray_up.gif" imgDown="systray_down.gif" event="toggleWindow" x="278" y="13" toolTip="Systray" />
  <button imgUp="minimize_up.gif" imgDown="minimize_down.gif" event="minimize" x="293" y="13" toolTip="Minimize" />
  <button imgUp="terminate_up.gif" imgDown="terminate_down.gif" event="terminate"  x="308" y="13" toolTip="Terminate" />

  <toggleButton imgUp="random_up.gif" imgDown="random_down.gif" event="random"  x="33" y="81" toolTip="Toggle Random" bg="#000000" fg="000000" />
  <toggleButton imgUp="repeat_up.gif" imgDown="repeat_down.gif" event="repeat"  x="48" y="80" toolTip="Toggle Repeat" bg="#000000" fg="000000" />



  <!-- Add labels to player -->
  <label type="status" length="220" height="15" bg="#000000" fg="#64DC14" scrolling="no" x="50" y="30" />
  <label type="artist" length="220" height="15" bg="#000000" fg="#14DADC" scrolling="yes" x="50" y="45" />
  <label type="title" length="220" height="15" bg="#000000" fg="#14DADC" scrolling="yes" x="50" y="60" />


  <!-- Add volume controll to player -->
  <volumeSlider size="5" x="1" y="1" />

  <!-- Add menu items to player. About and Exit are by default added to the end of the popup menu and cannot be overridden -->
  <menuItem name="Controls" event="parent" >
    <subItem name="Play" event="play" />
    <subItem name="Stop" event="stop" />
    <subItem name="Pause" event="pause" />
    <subItem name="Next" event="next" />
    <subItem name="Prev" event="prev" /> 
  </menuItem>
  <menuItem name="Playlist" event="playlist" />
  <menuItem name="Configure" event="configure" />
  <menuItem name="About" event="about" />
  <menuItem name="Exit" event="terminate" />

  <!-- PLAYLIST -->
  <!-- Set background image -->
  <playlistBgImage path="playlist_background.gif" />


  <!-- Add buttons to playlist -->
  <playlistButton imgUp="audio_file.ico" imgDown="audio_file.ico" 
                  event="showFileMenu" x="10" y="10" toolTip="Add file/dir" />
 
  <playlistButton imgUp="audio_http.ico" imgDown="audio_http.ico" 
                  event="addHttp" x="30" y="10" toolTip="Add http stream" />

  <playlistButton imgUp="audio_cd.ico" imgDown="audio_cd.ico" 
                  event="addCD" x="50" y="10" toolTip="Add CD" />

  <playlistButton imgUp="audio_home.ico" imgDown="audio_home.ico" 
                  event="addPympServer" x="70" y="10" toolTip="Add Pymp Server" />

  <playlistButton imgUp="audio_playlist.ico" imgDown="audio_playlist.ico" 
                  event="importPlaylist" x="90" y="10" toolTip="Import playlist" />

  <playlistButton imgUp="audio_save.ico" imgDown="audio_save.ico" 
                  event="savePlaylist" x="130" y="10" toolTip="Save playlist" />

  <playlistButton imgUp="audio_dustbin.ico" imgDown="audio_dustbin.ico" 
                  event="clearPlaylist" x="150" y="10" toolTip="Clear playlist" />

  <playlistButton imgUp="terminate_up.gif" imgDown="terminate_down.gif" 
                  event="toggleWindow" x="218" y="12" toolTip="Close" />


 


  <!-- position the playlist on frame -->
  <scrollList x="10" y="30" bg="#000000" fg="#64DC14" 
              height="312" width="219" />


</Skin>